# Test config files (users create these in their own projects)
.claude-bunker.json

# Environment files — never commit secrets
.env
.env.*

# Claude Code local config
.claude/

# Serena cache/state
.serena/

# Unix socket for hook-driven session monitoring
.bunker.sock

# Node
node_modules/

# Go build output
claude-bunker
claude-bunker.exe
claude-bunker.exe~
dist/

# Sandbox dotfiles — Claude Code's bubblewrap creates these in the workspace.
# The container bind-mounts /dev/null over them, but they can leak if the
# container exits uncleanly or the bind-mount fails.
.bash_profile
.bashrc
.gitconfig
.profile
.ripgreprc
.zprofile
.zshrc

# OS junk
.DS_Store
Thumbs.db

# Build the SNI-aware egress proxy (stdlib-only, standalone module) for the
# target arch. The builder stage is discarded from the final image.
FROM golang:1.23-bookworm AS proxybuild
WORKDIR /build
COPY egressproxy/ ./egressproxy/
RUN cd egressproxy && CGO_ENABLED=0 GOPROXY=off go build -trimpath -o /egress-proxy .

FROM debian:bookworm-slim

# Create {{.User}} user
RUN groupadd --gid 1000 {{.User}} && \
  useradd --uid 1000 --gid 1000 -m -s /bin/bash {{.User}}

# Dedicated non-root user for the egress proxy (privilege separation): it owns
# its config/CA/real-secret files, which the agent user cannot read.
RUN groupadd --gid {{.ProxyUID}} {{.ProxyUser}} && \
  useradd --uid {{.ProxyUID}} --gid {{.ProxyUID}} -M -s /usr/sbin/nologin {{.ProxyUser}}

# Install development tools, iptables for firewall, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
  bubblewrap \
  ca-certificates \
  curl \
  dnsutils \
  gh \
  git \
  ipset \
  iptables \
  iproute2 \
  less \
  openssh-client \
  ripgrep \
  socat \
  sudo \
  tmux \
  && apt-get clean && rm -rf /var/lib/apt/lists/* \
  && update-alternatives --set iptables /usr/sbin/iptables-legacy

# Timezone — placed after apt-get so TZ changes don't bust the package cache
ARG TZ=UTC
ENV TZ="$TZ"

# Persist bash history, create dirs
RUN SNIPPET="export PROMPT_COMMAND='history -a' && export HISTFILE={{.HistoryDir}}/.bash_history" \
  && mkdir {{.HistoryDir}} \
  && touch {{.HistoryDir}}/.bash_history \
  && chown -R {{.User}} {{.HistoryDir}} \
  && echo "$SNIPPET" >> "{{.Home}}/.bashrc" \
  && mkdir -p {{.Workspace}} {{.Home}}/.claude \
  && chown -R {{.User}}:{{.User}} {{.Workspace}} {{.Home}}/.claude \
  && mkdir -p {{.ManagedSettingsDir}}

WORKDIR {{.Workspace}}

# Switch to non-root user for Claude Code install
USER {{.User}}

ENV DEVCONTAINER=true
ENV SHELL=/bin/bash

# Install Claude Code via native installer.
# Downloaded to a temp file with hash verification for supply chain auditability.
# The installer is evergreen (updates with each release) so the hash is logged
# rather than pinned — review build logs to audit what was installed.
RUN set -e && \
  INSTALLER=$(mktemp) && \
  curl -fsSL https://claude.ai/install.sh -o "$INSTALLER" && \
  echo "Claude Code installer SHA-256: $(sha256sum "$INSTALLER" | cut -d' ' -f1)" && \
  head -c 2 "$INSTALLER" | grep -q '#!' || { echo "ERROR: installer does not start with shebang"; exit 1; } && \
  bash "$INSTALLER" && \
  rm -f "$INSTALLER"
ENV PATH="{{.Home}}/.local/bin:$PATH"

# COPY layers placed after expensive installs to avoid cache busting
USER root
COPY firewall-common.sh {{.CommonFirewallPath}}
COPY init-firewall.sh {{.FirewallPath}}
COPY refresh-firewall.sh {{.RefreshFirewallPath}}
COPY tmux.conf {{.Home}}/.tmux.conf
COPY --from=proxybuild /egress-proxy {{.ProxyBinaryPath}}
RUN chmod +x {{.CommonFirewallPath}} {{.FirewallPath}} {{.RefreshFirewallPath}} && \
  chown {{.User}}:{{.User}} {{.Home}}/.tmux.conf
RUN chmod 0755 {{.ProxyBinaryPath}}

# Scoped NOPASSWD sudo for exactly the firewall scripts, arg-pinned to the
# fixed root-owned allowlist path — allows the VS Code postStartCommand to
# run the firewall as the non-root user. sudo permits ONLY invocations with
# exactly this argument, so a compromised agent cannot pass its own domains
# file to widen the firewall. bunker's native build runs the firewall as
# root via docker-exec and never uses sudo, so this grant is additive and
# harmless for that path.
RUN echo '{{.User}} ALL=(root) NOPASSWD: {{.FirewallPath}} {{.AllowedDomainsPath}}, {{.RefreshFirewallPath}} {{.AllowedDomainsPath}}' > /etc/sudoers.d/claude-bunker-firewall && \
  chmod 0440 /etc/sudoers.d/claude-bunker-firewall
